# Application
APP_NAME="NXTutors"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CONNECT_TIMEOUT=5

# Cache, session, and queue
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=660
REDIS_QUEUE_RETRY_AFTER=660
PAGEGEN_WORKER_TIMEOUT=240
TUTOR_WORKER_TIMEOUT=600
QUEUE_WORKER_MAX_JOBS=100
TUTOR_QUEUE=default
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# OpenAI and AI services
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_CONNECT_TIMEOUT=10
OPENAI_REQUEST_TIMEOUT=90
OPENAI_RETRY_TIMES=1
OPENAI_PAGE_DAILY_LIMIT=100
OPENAI_TUTOR_DAILY_LIMIT=25
NXT_AI_FUNCTION_URL=

# NXT AI assistant (in-app OpenAI agent). Reuses OPENAI_API_KEY above.
NXT_AI_ENABLED=true
NXT_AI_MODEL=gpt-5-mini
NXT_AI_MAX_TOOL_ROUNDS=4
NXT_AI_MAX_OUTPUT_TOKENS=700
NXT_AI_CONNECT_TIMEOUT=10
NXT_AI_REQUEST_TIMEOUT=60
NXT_AI_MAX_RESULTS=6
NXT_AI_DAILY_LIMIT=400
NXT_AI_LOG_CONTENT=false
NXT_AI_HISTORY_MESSAGES=12
NXT_AI_GUEST_RETENTION_DAYS=14
NXT_AI_MESSAGE_MAX_CHARS=1500
NXT_AI_RATE_PER_MINUTE=12
NXT_AI_RATE_GUEST_PER_DAY=60
NXT_AI_RATE_USER_PER_DAY=300
NXT_AI_CONFIRMATION_TTL=900

# Cashfree
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2025-01-01

# Pincode provider
PINCODE_API_BASE_URL=https://api.postalpincode.in/pincode
RAPIDAPI_PINCODE_KEY=
RAPIDAPI_PINCODE_HOST=
PINCODE_CONNECT_TIMEOUT=5
PINCODE_REQUEST_TIMEOUT=10
PINCODE_CACHE_SECONDS=86400
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_OPEN_SECONDS=120

# Import and processing safety
PAGEGEN_IMPORT_MAX_FILE_KB=10240
PAGEGEN_IMPORT_MAX_ROWS=500
PAGEGEN_IMPORT_BATCH_SIZE=25
TUTOR_IMPORT_MAX_ROWS=250
TUTOR_IMPORT_BATCH_SIZE=2
PROCESSING_STALE_AFTER_MINUTES=30
TEMP_FILE_RETENTION_DAYS=7

# Application rate limits (requests per minute)
RATE_LIMIT_PUBLIC_FORM=10
RATE_LIMIT_PUBLIC_API=30
RATE_LIMIT_PAYMENT=10
RATE_LIMIT_WEBHOOK=120
RATE_LIMIT_ADMIN_GENERATION=5
RATE_LIMIT_ADMIN_IMPORT=3

# Demo Command Center private Laravel gateway
# Set these in GitHub/CloudPanel secrets/variables; do not commit live keys.
DEMO_COMMAND_CENTER_GATEWAY_ENABLED=false
DEMO_COMMAND_CENTER_HMAC_KEYS_JSON={}
DEMO_COMMAND_CENTER_HMAC_SOURCE=demo-command-center
DEMO_COMMAND_CENTER_HMAC_AUDIENCE=nxtutors-website-gateway
DEMO_COMMAND_CENTER_REPLAY_WINDOW_SECONDS=300
DEMO_COMMAND_CENTER_MAX_CLOCK_SKEW_SECONDS=30
DEMO_COMMAND_CENTER_MAX_BODY_BYTES=65536
DEMO_COMMAND_CENTER_RATE_LIMIT_PER_MINUTE=120
DEMO_COMMAND_CENTER_AUDIT_REQUIRED=true
DEMO_COMMAND_CENTER_AUDIT_IP_HASH_KEY=
DEMO_COMMAND_CENTER_DEFAULT_CURRENCY=INR
DEMO_COMMAND_CENTER_IDEMPOTENCY_RETENTION_HOURS=168
DEMO_COMMAND_CENTER_TABLE_REGISTER=register
DEMO_COMMAND_CENTER_TABLE_COURSE_MANAGEMENT=teacher_course_managment
DEMO_COMMAND_CENTER_TABLE_TEACHER_COURSES=teacher_courses
DEMO_COMMAND_CENTER_TABLE_REVIEWS=teacher_review
DEMO_COMMAND_CENTER_TABLE_PLANS=subscription_plans
DEMO_COMMAND_CENTER_TABLE_SUBSCRIPTIONS=user_subscriptions
DEMO_COMMAND_CENTER_TABLE_ORDERS=order_managment
DEMO_COMMAND_CENTER_TABLE_DEMO_LEADS=demo_leads
DEMO_COMMAND_CENTER_REGION_MAPPING_VERSION=nxtutors-v1
DEMO_COMMAND_CENTER_SUBSCRIPTION_ACTIVE_STATUS=active
DEMO_COMMAND_CENTER_SUBSCRIPTION_PAID_STATUS=paid
DEMO_COMMAND_CENTER_SUBSCRIPTION_TYPE=paid

# Social links
NXT_FACEBOOK=
NXT_INSTAGRAM=
NXT_LINKEDIN=
NXT_GOOGLE_BUSINESS=

# Vite
VITE_APP_NAME="${APP_NAME}"

# --- NXTutors Tutor Intelligence Agent — read-only tutor feed
# GET /internal/agent/tutors, HMAC-signed, no write path.
# The agent runs on AWS Lambda with no network route to this database, so it
# reads tutors over this feed instead. Leave the key blank to disable the feed:
# the middleware fails closed and every request is refused with 503.
# Must equal TMM_WEBSITE_API_SIGNING_KEY on the agent side.
AGENT_FEED_SIGNING_KEY=
AGENT_FEED_TIMESTAMP_TOLERANCE=300
AGENT_FEED_MAX_PAGE_SIZE=200
AGENT_FEED_RATE_LIMIT=60
AGENT_FEED_ALLOWED_AGENTS=tutor_match_meta_agent
